# ADHD Stack 本体（Next.js / OpenNext）
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
SITE_URL=http://localhost:3000

# 以下は Convex ダッシュボード（または `npx convex env set`）に入れる。
# このファイルにシークレットを書かないこと。

# ChatGPT は Codex デバイスログイン。CHATGPT_CLIENT_ID / SECRET は不要。
# Cloud Environments には Plus 以上が必要（Free / Go では足りない）

# GitHub / Convex は接続カタログ側の OAuth（Convex 環境変数）。
# トークンはカタログ側。このファイルにシークレットを書かない。
OPENCONNECTOR_BASE_URL=
OPENCONNECTOR_ADMIN_TOKEN=
# 任意。後続の Actions 用。接続画面には不要。
OPENCONNECTOR_RUNTIME_TOKEN=

# GitHub / Convex のカスタム OAuth は接続開始に使わない（残しても無視）。
# 以前の実験用。新規に増やさない。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Cloudflare OAuth client
# Manage Account → OAuth clients
# 認可: https://dash.cloudflare.com/oauth2/auth
# コールバック: https://<deployment>.convex.site/oauth/callback/cloudflare
CLOUDFLARE_CLIENT_ID=
CLOUDFLARE_CLIENT_SECRET=

# Convex Platform OAuth application
# Team Settings → OAuth applications
# 認可: https://dashboard.convex.dev/oauth/authorize/team
# コールバック: https://<deployment>.convex.site/oauth/callback/convex
CONVEX_OAUTH_CLIENT_ID=
CONVEX_OAUTH_CLIENT_SECRET=
